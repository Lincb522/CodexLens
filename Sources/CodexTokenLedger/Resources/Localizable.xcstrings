        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원장은 현재 Codex Home에 속합니다. 이전 기록은 현재 계정에 재할당되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
