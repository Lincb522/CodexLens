        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 Codex 帳號"
          }
        }
      }
    },
    "account.addHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use OAuth, import JSON, or monitor an existing Codex Home. Credentials stay in isolated local profiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa OAuth, importa JSON o supervisa un Codex Home existente. Las credenciales permanecen en perfiles locales aislados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez OAuth, importez un JSON ou surveillez un Codex Home existant. Les identifiants restent dans des profils locaux isolés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth、JSON 読み込み、または既存 Codex Home の監視に対応します。認証情報は分離されたローカルプロファイルに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth, JSON 가져오기 또는 기존 Codex Home 모니터링을 지원합니다. 자격 증명은 격리된 로컬 프로필에 보관됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 OAuth、导入 JSON，或监控已有 Codex Home。凭据会保存在隔离的本地账号目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 OAuth、匯入 JSON，或監控現有 Codex Home。憑證會留在隔離的本機設定檔。"
          }
        }
      }
    },
