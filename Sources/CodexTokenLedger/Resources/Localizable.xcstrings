    "console.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live tasks are discovered from the Codex lifecycle. Model capacity, runtime context and per-call long-context pricing are tracked separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas activas se detectan mediante el ciclo de vida de Codex. La capacidad del modelo, el contexto de ejecución y las tarifas de contexto largo por llamada se controlan por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches actives sont détectées via le cycle de vie de Codex. La capacité du modèle, le contexte d’exécution et les tarifs de contexte long par appel sont suivis séparément."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブタスクは Codex のライフサイクルから検出します。モデル容量、実行コンテキスト、呼び出し単位の長文料金は別々に追跡します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 작업은 Codex 수명 주기에서 검색합니다. 모델 용량, 런타임 컨텍스트 및 호출별 긴 컨텍스트 요금은 별도로 추적됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时任务按 Codex 生命周期发现；模型容量、运行时上下文与逐调用超长费率分开追踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時任務依 Codex 生命週期探索；模型容量、執行上下文與逐次長上下文費率分開追蹤。"
          }
        }
      }
    },
