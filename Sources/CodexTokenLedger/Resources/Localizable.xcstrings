    "account.activateHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validate the target, save the current login, atomically switch Codex and monitor it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valida el destino, guarda la sesión actual y cambia Codex de forma atómica antes de supervisarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valider la cible, sauvegarder la connexion actuelle puis basculer Codex atomiquement et la surveiller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象認証を検証し、現在のログインを保存してから Codex を原子的に切り替え、監視します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 자격 증명을 확인하고 현재 로그인을 저장한 뒤 Codex를 원자적으로 전환하여 모니터링합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先验证目标凭据、保存当前登录，再原子切换 Codex 并开始监控。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先驗證目標憑證、保存目前登入，再原子切換 Codex 並開始監控。"
          }
        }
      }
    },
